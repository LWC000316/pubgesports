# Docker and Local Database
postgres_data/
*.h2.db

# 리퀴피디아 API 응답 캐시 (약관상 캐싱은 필요하지만 저장소에 넣을 산출물은 아니다)
intermediate_results/liquipedia_cache/

# 대회 경기 원본. 공식 API 에서 다시 받을 수 있어 추적하지 않는다 (대회당 약 3MB).
# 집계 결과인 primary_data/tournaments/*.json 만 커밋한다.
intermediate_results/tournaments/

# 텔레메트리 원본. 경기당 33MB 라 저장소에 넣지 않는다.
# 집계 결과인 primary_data/matchlogs/*.json 만 커밋한다 (경기당 약 300KB).
intermediate_results/telemetry/

# 대량 수집 진행 로그. 재실행하면 다시 생긴다.
ingest/fetch_all.progress
# 수집 전 확인용으로 받아 본 경기 원본. tournaments/ 와 같은 성격이다.
intermediate_results/probe/

# 경쟁전 자기장은 primary_data/ranked_zones 에 남긴다 (경기당 2KB).
# 원본 텔레메트리는 뽑는 즉시 버리므로 따로 무시할 것이 없다.
